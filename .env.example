# Konfigurasi Lingkungan Web Dashboard SIMSIT
# Sesuaikan VITE_API_BASE_URL dengan endpoint REST API backend Laravel Anda.

# 1. Mode Lokal (Laptop Developer)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_BACKEND_URL=http://localhost:8000

# 2. Mode LAN (Akses dari HP / Tablet lain dalam 1 Wi-Fi)
# Ganti dengan IP komputer developer yang menjalankan backend
# VITE_API_BASE_URL=http://192.168.1.7:8000/api
# VITE_BACKEND_URL=http://192.168.1.7:8000

# 3. Mode Staging
# VITE_API_BASE_URL=https://staging-api.sekolah.sch.id/api
# VITE_BACKEND_URL=https://staging-api.sekolah.sch.id

# 4. Mode Production (Server VPS / Cloud)
# VITE_API_BASE_URL=https://api.sekolah.sch.id/api
# VITE_BACKEND_URL=https://api.sekolah.sch.id

# Port WebSocket untuk notifikasi real-time (opsional)
VITE_WS_PORT=6001
